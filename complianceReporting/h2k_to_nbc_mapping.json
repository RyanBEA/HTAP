  "formulas": {
    "fdwr_calculation": {
      "description": "Calculate fenestration and door to wall ratio as percentage",
      "inputs": {
        "window_se": ".//AllResults/Results/Other/GrossArea/MainFloors/Windows/SouthEast",
        "window_ne": ".//AllResults/Results/Other/GrossArea/MainFloors/Windows/NorthEast",
        "window_nw": ".//AllResults/Results/Other/GrossArea/MainFloors/Windows/NorthWest",
        "window_sw": ".//AllResults/Results/Other/GrossArea/MainFloors/Windows/SouthWest",
        "window_s": ".//AllResults/Results/Other/GrossArea/MainFloors/Windows/South",
        "window_n": ".//AllResults/Results/Other/GrossArea/MainFloors/Windows/North",
        "window_e": ".//AllResults/Results/Other/GrossArea/MainFloors/Windows/East",
        "window_w": ".//AllResults/Results/Other/GrossArea/MainFloors/Windows/West",
        "door_main": ".//AllResults/Results/Other/GrossArea/MainFloors/Door",
        "door_basement": ".//AllResults/Results/Other/GrossArea/Basement/Door",
        "wall_main": ".//AllResults/Results/Other/GrossArea/MainFloors",
        "wall_basement_above": ".//AllResults/Results/Other/GrossArea/Basement"
      },
      "input_attrs": {
        "window_se": "grossArea",
        "window_ne": "grossArea",
        "window_nw": "grossArea",
        "window_sw": "grossArea",
        "window_s": "grossArea",
        "window_n": "grossArea",
        "window_e": "grossArea",
        "window_w": "grossArea",
        "door_main": "grossArea",
        "door_basement": "grossArea",
        "wall_main": "mainWalls",
        "wall_basement_above": "aboveGrade"
      },
      "calculation": "((window_se + window_ne + window_nw + window_sw + window_s + window_n + window_e + window_w + door_main + door_basement) / (wall_main + wall_basement_above)) * 100 if (wall_main + wall_basement_above) > 0 else 0",
      "format": "%.1f"
    },
    "total_window_door_area": {
      "description": "Calculate total fenestration and door area in mÂ²",
      "inputs": {
        "window_se": ".//AllResults/Results/Other/GrossArea/MainFloors/Windows/SouthEast",
        "window_ne": ".//AllResults/Results/Other/GrossArea/MainFloors/Windows/NorthEast",
        "window_nw": ".//AllResults/Results/Other/GrossArea/MainFloors/Windows/NorthWest",
        "window_sw": ".//AllResults/Results/Other/GrossArea/MainFloors/Windows/SouthWest",
        "window_s": ".//AllResults/Results/Other/GrossArea/MainFloors/Windows/South",
        "window_n": ".//AllResults/Results/Other/GrossArea/MainFloors/Windows/North",
        "window_e": ".//AllResults/Results/Other/GrossArea/MainFloors/Windows/East",
        "window_w": ".//AllResults/Results/Other/GrossArea/MainFloors/Windows/West",
        "door_main": ".//AllResults/Results/Other/GrossArea/MainFloors/Door",
        "door_basement": ".//AllResults/Results/Other/GrossArea/Basement/Door"
      },
      "input_attrs": {
        "window_se": "grossArea",
        "window_ne": "grossArea",
        "window_nw": "grossArea",
        "window_sw": "grossArea",
        "window_s": "grossArea",
        "window_n": "grossArea",
        "window_e": "grossArea",
        "window_w": "grossArea",
        "door_main": "grossArea",
        "door_basement": "grossArea"
      },
      "calculation": "window_se + window_ne + window_nw + window_sw + window_s + window_n + window_e + window_w + door_main + door_basement",
      "format": "%.1f"
    },
    "ventilation_power": {
      "description": "Calculate ventilation fan power in W/L/s",
      "inputs": {
        "fan_power": ".//House/Ventilation/WholeHouseVentilatorList/Hrv",
        "flow_rate": ".//House/Ventilation/WholeHouseVentilatorList/Hrv"
      },
      "input_attrs": {
        "fan_power": "fanPower1",
        "flow_rate": "supplyFlowrate"
      },
      "calculation": "fan_power / flow_rate if flow_rate > 0 else 0",
      "format": "%.2f"
    },
    "parallel_path_rsi_walls": {
      "description": "Calculate area-weighted average RSI for walls using parallel path method",
      "type": "parallel_path_rsi",
      "elements_xpath": ".//House/Components/Wall",
      "rvalue_xpath": "./Construction/Type",
      "rvalue_attr": "rValue",
      "area_height_xpath": "./Measurements",
      "area_height_attr": "height",
      "area_perimeter_xpath": "./Measurements",
      "area_perimeter_attr": "perimeter",
      "format": "%.2f"
    },
    "parallel_path_rsi_ceilings": {
      "description": "Calculate area-weighted average RSI for ceilings using parallel path method",
      "type": "parallel_path_rsi",
      "elements_xpath": ".//House/Components/Ceiling",
      "rvalue_xpath": "./Construction/CeilingType",
      "rvalue_attr": "rValue",
      "area_xpath": "./Measurements",
      "area_attr": "area",
      "format": "%.2f"
    },
    "parallel_path_rsi_ceilings_attic": {
      "description": "Calculate area-weighted average RSI for attic ceilings (Attic/gable, Attic/hip) using parallel path method",
      "type": "parallel_path_rsi",
      "elements_xpath": ".//House/Components/Ceiling",
      "type_filter": ["Attic/gable", "Attic/hip"],
      "type_xpath": "./Construction/Type/English",
      "rvalue_xpath": "./Construction/CeilingType",
      "rvalue_attr": "rValue",
      "area_xpath": "./Measurements",
      "area_attr": "area",
      "format": "%.2f"
    },
    "parallel_path_rsi_ceilings_cathedral_flat": {
      "description": "Calculate area-weighted average RSI for cathedral ceilings and flat roofs using parallel path method",
      "type": "parallel_path_rsi",
      "elements_xpath": ".//House/Components/Ceiling",
      "type_filter": ["Flat", "Cathedral"],
      "type_xpath": "./Construction/Type/English",
      "rvalue_xpath": "./Construction/CeilingType",
      "rvalue_attr": "rValue",
      "area_xpath": "./Measurements",
      "area_attr": "area",
      "format": "%.2f"
    },
    "parallel_path_rsi_floors": {
      "description": "Calculate area-weighted average RSI for exposed floors using parallel path method",
      "type": "parallel_path_rsi",
      "elements_xpath": ".//House/Components/Floor",
      "rvalue_xpath": "./Construction/Type",
      "rvalue_attr": "rValue",
      "area_xpath": "./Measurements",
      "area_attr": "area",
      "format": "%.2f"
    }
  },
  "transformations": {
    "text": {
      "type": "passthrough",
      "description": "Return text value as-is"
    },
    "concatenate": {
      "type": "join",
      "description": "Join multiple values with separator"
    },
    "climate_zone": {
      "type": "lookup",
      "description": "Convert heating degree days to climate zone",
      "ranges": [
        {
          "min": 0,
          "max": 2999,
          "value": "Zone 4 (<3000 HDD)"
        },
        {
          "min": 3000,
          "max": 3999,
          "value": "Zone 5 (3000-3999 HDD)"
        },
        {
          "min": 4000,
          "max": 4999,
          "value": "Zone 6 (4000-4999 HDD)"
        },
        {
          "min": 5000,
          "max": 5999,
          "value": "Zone 7A (5000-5999 HDD)"
        },
        {
          "min": 6000,
          "max": 99999,
          "value": "Zone 7B/8 (â‰¥6000 HDD)"
        }
      ]
    },
    "orientation_abbr": {
      "type": "map",
      "description": "Convert orientation to abbreviation",
      "mapping": {
        "North": "N",
        "Northeast": "NE",
        "East": "E",
        "Southeast": "SE",
        "South": "S",
        "Southwest": "SW",
        "West": "W",
        "Northwest": "NW"
      }
    },
    "r_to_u": {
      "type": "calculation",
      "description": "Convert R-value to U-value (U = 1/R)",
      "formula": "1 / value if value > 0 else 0"
    },
    "round1": {
      "type": "round",
      "description": "Round to 1 decimal place",
      "decimals": 1
    },
    "round2": {
      "type": "round",
      "description": "Round to 2 decimal places",
      "decimals": 2
    },
    "average_round2": {
      "type": "average",
      "description": "Calculate average and round to 2 decimal places",
      "decimals": 2
    },
    "wood_stove_check": {
      "type": "map",
      "description": "Convert wood stove count to text",
      "mapping": {
        "0": "None",
        "1": "Wood stove"
      }
    }
  },
  "complex_mappings": {
    "heating_system": {
      "description": "Format heating system description",
      "components": [
        {
          "xpath": ".//House/HeatingCooling/Type1/Furnace/Equipment/EnergySource/English",
          "default": "Unknown"
        },
        {
          "xpath": ".//House/HeatingCooling/Type1/Furnace/Equipment/EquipmentType/English",
          "default": "furnace"
        },
        {
          "xpath": ".//House/HeatingCooling/Type1/Furnace/Specifications",
          "attr": "efficiency",
          "default": "0"
        }
      ],
      "format": "{0} {1}, {2}% AFUE"
    },
